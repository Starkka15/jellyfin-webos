{
	"id": "com.stark.jellyfin.service",
	"description": "Relays https video streams for the Jellyfin app",
	"engine": "node",
	"activityTimeout": 120,
	"services": [
		{
			"name": "com.stark.jellyfin.service",
			"globalized": false,
			"commands": [
				{ "name": "relay", "assistant": "relayAssistant", "public": true },
				{ "name": "ping",  "assistant": "pingAssistant",  "public": true }
			]
		}
	]
}
